{
  "$schema": "../gittydocs.schema.json",
  "site": {
    "name": "gittydocs",
    "version": { "packageJson": "../packages/cli/package.json" },
    "description": "Simple, fast docs from your Markdown.",
    "logo": "/static/gittydocs_logo.png",
    "favicon": "/static/gittydocs_logo.png",
    "socialBanner": "/static/gittydocs_mainbanner.jpg",
    "repo": {
      "owner": "blankeos",
      "name": "gittydocs",
      "ref": "main",
      "docsPath": "docs"
    }
  },
  "theme": {
    "preset": "ocean"
  },
  "nav": [
    {
      "label": "Docs",
      "icon": "book",
      "items": [
        { "label": "Introduction", "path": "/introduction", "icon": "book" },
        { "label": "Motivation", "path": "/motivation", "icon": "rocket" },
        { "label": "AI Docs Prompt", "path": "/ai-docs-prompt", "icon": "file" },
        { "label": "Configuration", "path": "/configuration", "icon": "settings" },
        { "label": "Navigation", "path": "/navigation", "icon": "folder" },
        { "label": "CLI", "path": "/cli", "icon": "terminal" },
        { "label": "Theming", "path": "/theming", "icon": "settings" }
      ]
    },
    {
      "label": "Components",
      "path": "/components",
      "icon": "package",
      "items": [
        { "label": "Code blocks", "path": "/components/code-blocks", "icon": "code" },
        { "label": "Callouts", "path": "/components/callouts", "icon": "file" },
        {
          "label": "Authoring",
          "icon": "book",
          "accordion": true,
          "defaultOpen": true,
          "items": [
            { "label": "Steps", "path": "/components/steps", "icon": "hash" },
            { "label": "Files", "path": "/components/files", "icon": "folder" },
            { "label": "Accordion", "path": "/components/accordion", "icon": "file" },
            { "label": "Tabs", "path": "/components/tabs", "icon": "file" },
            { "label": "Type Table", "path": "/components/type-table", "icon": "file" },
            { "label": "Auto Type Table", "path": "/components/auto-type-table", "icon": "file" }
          ]
        }
      ]
    },
    {
      "label": "Deploy",
      "icon": "rocket",
      "accordion": true,
      "items": [
        { "label": "Overview", "path": "/deploy" },
        { "label": "GitHub Pages", "path": "/deploy/github-pages" },
        { "label": "Vercel", "path": "/deploy/vercel" },
        { "label": "Cloudflare Pages", "path": "/deploy/cloudflare" },
        { "label": "Netlify", "path": "/deploy/netlify" }
      ]
    }
  ],
  "navFooter": [
    { "label": "GitHub", "path": "https://github.com/blankeos/gittydocs", "icon": "github" }
  ],
  "links": {
    "github": "https://github.com/blankeos/gittydocs",
    "issues": "https://github.com/blankeos/gittydocs/issues"
  }
}
