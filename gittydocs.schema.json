{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "site": {
      "description": "Site metadata",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Site title"
        },
        "version": {
          "description": "Version label or manifest path, relative to the original docs/config folder",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Literal version label"
            },
            {
              "type": "object",
              "properties": {
                "packageJson": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Path to package.json"
                }
              },
              "required": [
                "packageJson"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "cargoToml": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Path to Cargo.toml"
                }
              },
              "required": [
                "cargoToml"
              ],
              "additionalProperties": false
            }
          ]
        },
        "description": {
          "description": "Short site description used in /llms.txt",
          "type": "string"
        },
        "logo": {
          "description": "Logo image URL or public path",
          "type": "string"
        },
        "favicon": {
          "description": "Favicon URL or public path",
          "type": "string"
        },
        "socialBanner": {
          "description": "Social preview image (Open Graph/Twitter) URL or path",
          "type": "string"
        },
        "repo": {
          "description": "Repository metadata for edit links",
          "type": "object",
          "properties": {
            "owner": {
              "type": "string",
              "description": "GitHub username or org"
            },
            "name": {
              "type": "string",
              "description": "Repository name"
            },
            "ref": {
              "description": "Branch or tag",
              "type": "string"
            },
            "docsPath": {
              "description": "Path to docs folder",
              "type": "string"
            }
          },
          "required": [
            "owner",
            "name"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "nav": {
      "description": "Custom navigation sections",
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema0"
      }
    },
    "navFooter": {
      "description": "Ordered sidebar footer links, alongside llms.txt and above the site version",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Footer navigation label"
          },
          "path": {
            "type": "string",
            "description": "Route path or external URL"
          },
          "icon": {
            "description": "Built-in navigation icon name (unknown names use file)",
            "type": "string"
          },
          "newTab": {
            "description": "Open in a new tab (default: true for external HTTP(S) URLs, false for internal routes)",
            "type": "boolean"
          }
        },
        "required": [
          "label",
          "path"
        ],
        "additionalProperties": false,
        "description": "Footer navigation link (no groups or collapsible sections)"
      }
    },
    "ui": {
      "description": "Page navigation controls",
      "type": "object",
      "properties": {
        "breadcrumbs": {
          "description": "Show page breadcrumbs (default: true)",
          "type": "boolean"
        },
        "pageNavigation": {
          "description": "Show previous/next page links (default: true)",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "links": {
      "description": "External links",
      "type": "object",
      "properties": {
        "github": {
          "description": "URL to repository or org",
          "type": "string"
        },
        "issues": {
          "description": "URL to issues page",
          "type": "string"
        },
        "discord": {
          "description": "URL to Discord server",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "description": "Theme configuration",
      "type": "object",
      "properties": {
        "preset": {
          "description": "Preset theme name (see /theming)",
          "type": "string",
          "enum": [
            "default",
            "slate",
            "sage",
            "ember",
            "ocean",
            "sand",
            "mono"
          ]
        },
        "cssFile": {
          "description": "Path to a CSS file in your docs folder",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "llms": {
      "description": "LLM output configuration",
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Generate /llms.txt at build time",
          "type": "boolean"
        },
        "path": {
          "description": "Folder for per-page LLM markdown",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "$schema": {
      "description": "JSON Schema reference",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "__schema0": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "description": "Navigation label"
        },
        "path": {
          "description": "Route path or external URL",
          "type": "string"
        },
        "items": {
          "description": "Nested navigation items",
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema0"
          }
        },
        "accordion": {
          "description": "Render as collapsible section",
          "type": "boolean"
        },
        "icon": {
          "description": "Built-in navigation icon name (unknown names use file)",
          "type": "string"
        },
        "newTab": {
          "description": "Open this navigation link in a new tab",
          "type": "boolean"
        },
        "defaultOpen": {
          "description": "Initially expand this collapsible section",
          "type": "boolean"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "description": "Navigation item"
    }
  },
  "$id": "https://raw.githubusercontent.com/blankeos/gittydocs/main/gittydocs.schema.json",
  "title": "GittydocsConfig"
}
